---
import Base from '../../layouts/Base.astro';
import { t, subjectName, langPaths, type Lang } from '../../i18n';
import { subjectsList, unitsOf, allCards } from '../../lib/content';
import { subjectConf, unitLabel } from '../../lib/subjects';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const subjects = await subjectsList(lang);
const nUnits = Object.fromEntries(await Promise.all(subjects.map(async (s) => [s, (await unitsOf(lang, s)).length] as const)));
const cards = (await allCards(lang)).map(({ id, subject }) => ({ id, subject }));
---
<Base lang={lang}>
  <h1>{t(lang, 'home.title')}</h1>
  <p class="muted" style="margin-top:-.5rem">{t(lang, 'home.pick')}</p>
  {subjects.length === 0 && <p class="glass empty muted">{t(lang, 'home.empty')}</p>}
  <div class="subjects">
    {subjects.map((s) => (
      <a class="subject-tile glass" href={`/${lang}/${s}/`} data-s={s}>
        <span class="subject-icon">{subjectConf(s).icon}</span>
        <span class="subject-body">
          <strong>{subjectName(lang, s)}</strong>
          <span class="muted small">{nUnits[s]} {unitLabel(lang, s).toLowerCase()}{nUnits[s] > 1 ? 's' : ''} · <span data-total>0</span> {t(lang, 'subject.cards')}</span>
          <span class="progress" style="margin-top:.5rem"><i class="m" data-bar></i></span>
        </span>
        <span class="due-pill" data-due hidden></span>
        <span class="arrow">›</span>
      </a>
    ))}
  </div>
  <script type="application/json" id="cards" set:html={JSON.stringify(cards)} />
</Base>

<script>
  import { load, isDue } from '../../scripts/progress';
  const cards: { id: string; subject: string }[] = JSON.parse(document.getElementById('cards')!.textContent!);
  function stats() {
    const p = load();
    document.querySelectorAll<HTMLElement>('.subject-tile').forEach((tile) => {
      const list = cards.filter((c) => c.subject === tile.dataset.s);
      const m = list.filter((c) => p.cards[c.id]?.box === 5).length;
      const d = list.filter((c) => isDue(p, c.id)).length;
      tile.querySelector('[data-total]')!.textContent = String(list.length);
      requestAnimationFrame(() => requestAnimationFrame(() => (tile.querySelector<HTMLElement>('[data-bar]')!.style.width = list.length ? `${(m / list.length) * 100}%` : '0')));
      const due = tile.querySelector<HTMLElement>('[data-due]')!;
      due.hidden = !d; due.textContent = String(d);
    });
  }
  stats();
  document.addEventListener('progress:ready', stats);
</script>
