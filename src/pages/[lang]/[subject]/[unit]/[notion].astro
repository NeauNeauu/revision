---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { t, subjectName, type Lang } from '../../../../i18n';
import { parts, mathText } from '../../../../lib/content';
import { subjectConf, unitLabel } from '../../../../lib/subjects';
export async function getStaticPaths() {
  return (await getCollection('units')).flatMap((entry) => {
    const { lang, subject, slug } = parts(entry.id);
    return entry.data.notions.map((_, i) => ({ params: { lang, subject, unit: slug, notion: `n${i}` }, props: { entry, i } }));
  });
}
const { entry, i } = Astro.props;
const lang = Astro.params.lang as Lang;
const { subject, unit } = Astro.params as { subject: string; unit: string };
const d = entry.data, n = d.notions[i];
const speech = subjectConf(subject).speech;
const label = unitLabel(lang, subject);
const total = d.notions.length;
const base = `/${lang}/${subject}/${unit}/`;
const L = lang === 'fr'
  ? { brief: 'En bref', steps: 'Pas à pas', ex: 'Exemples', pit: 'Pièges', prove: 'Prouve-le', check: 'Vérifier', dunno: 'Je ne sais pas', ok: 'Correct ✓', ko: 'Réponse attendue :', next: 'Suivant →', done: 'Notion validée', again: 'Refaire', score: 'réussis', none: 'Pas encore d’exercices pour cette notion.', all: 'Toutes les notions', kb: 'Clavier hangul', ph: 'Réponse en coréen…' }
  : { brief: 'In short', steps: 'Step by step', ex: 'Examples', pit: 'Pitfalls', prove: 'Prove it', check: 'Check', dunno: "I don't know", ok: 'Correct ✓', ko: 'Expected answer:', next: 'Next →', done: 'Notion validated', again: 'Redo', score: 'correct', none: 'No exercises for this notion yet.', all: 'All notions', kb: 'Hangul keyboard', ph: 'Answer in Korean…' };
const ex = n.exercises.length ? n.exercises : d.drills.filter((x) => n.topic && x.topic === n.topic).slice(0, 8).map((x) => ({ q: x.q, a: x.a }));
const prev = d.notions[i - 1] && `${base}n${i - 1}/`, next = d.notions[i + 1] && `${base}n${i + 1}/`;
---
<Base lang={lang} title={`${n.name.replace(/\$/g, "")} · ${d.title}`}>
  <p class="eyebrow"><a href={base}>← {label} {d.order} · {d.title}</a></p>
  <p class="eyebrow" style="margin-top:1rem">{n.category} · {i + 1}/{total}</p>
  <h1 style="margin-top:.2rem" set:html={mathText(n.name)} />
  <div class="progress" style="margin:.6rem 0 1rem"><i class="m" style={`width:${((i + 1) / total) * 100}%`}></i></div>

  <h2>{L.brief}</h2>
  <p class="box" set:html={mathText(n.explanation)} />
  {n.steps.length > 0 && (<><h2>{L.steps}</h2><ol class="steps">{n.steps.map((s) => <li set:html={mathText(s)} />)}</ol></>)}
  {n.visual.map((v) => (
    <div class="vis">
      {v.eq && <div class="eq">{v.eq.map((x) => (/^[+=→×≈]$/.test(x) ? <span class="op">{x}</span> : <span class="pill" lang="ko" set:html={mathText(x)} />))}</div>}
      {v.rows && <div class="vrows">{v.rows.map((r) => <div class="vrow"><span class="pill cond" set:html={mathText(r.if)} /><span class="op">→</span><span class="pill" lang="ko" set:html={mathText(r.then)} />{r.ex && <span class="muted small" lang="ko">{r.ex}</span>}</div>)}</div>}
    </div>
  ))}
  {n.examples.length > 0 && (
    <>
      <h2>{L.ex}</h2>
      <ul class="examples">
        {n.examples.map((x) => (
          <li>
            {speech && <button type="button" class="speak" data-speak={x.text} data-lang={speech} aria-label={t(lang, 'review.listen')}>🔊</button>}
            <span><span lang={speech ? 'ko' : undefined} set:html={mathText(x.text)} />{x.reading && <span class="muted small"> · {x.reading}</span>}<br /><span class="muted" set:html={mathText(x.tr)} /></span>
          </li>
        ))}
      </ul>
    </>
  )}
  {n.mnemonic && <div class="mnemo">💡 <Fragment set:html={mathText(n.mnemonic)} /></div>}
  {n.pitfalls.length > 0 && (<><h2>{L.pit}</h2><ul class="pits">{n.pitfalls.map((s) => <li set:html={mathText(s)} />)}</ul></>)}

  <h2 id="prove">{L.prove}</h2>
  {ex.length === 0 ? <p class="muted">{L.none}</p> : subjectConf(subject).reveal ? (
    <div class="xos">{ex.map((x) => <details class="xo"><summary set:html={mathText(x.q)} /><div class="sol" set:html={mathText(x.a)} /></details>)}</div>
  ) : (
    <div class="glass" style="padding:1rem 1.2rem" id="quiz">
      <div class="row between"><span class="muted small" id="qn"></span><span class="muted small" id="qs"></span></div>
      <p class="term" id="qq" style="font-size:1.25rem;margin:.8rem 0"></p>
      <form id="qf" autocomplete="off">
        <div class="row" style="gap:.5rem"><input id="qi" lang="ko" style="flex:1;font-size:1.3rem" placeholder={L.ph} autocapitalize="off" autocorrect="off" spellcheck="false" /><button class="btn primary" id="qok">{L.check}</button></div>
        <div class="row between" style="margin-top:.5rem"><button type="button" class="btn" id="qd">{L.dunno}</button><span class="row" style="gap:.8rem"><select id="kl" aria-label="layout"><option value="qwerty">QWERTY</option><option value="azerty">AZERTY</option></select><label class="switch"><input type="checkbox" id="kt" /> {L.kb}</label></span></div>
        <div class="kbd" id="kbd"></div>
      </form>
      <div class="box" id="qr" hidden><p id="qm" style="margin:0 0 .6rem"></p><button type="button" class="btn primary" id="qnx">{L.next}</button></div>
      <div id="qend" hidden><p class="term" id="qe"></p><button type="button" class="btn" id="qre">{L.again}</button></div>
    </div>
  )}
  <script type="application/json" id="ex" set:html={JSON.stringify(ex)} />
  <template id="l" data-ok={L.ok} data-ko={L.ko} data-done={L.done} data-score={L.score} data-id={`notion/${subject}/${unit}/n${i}`}></template>

  <nav class="pager" style="margin-top:2rem">
    {prev ? <a class="btn" href={prev}>← {i}</a> : <a class="btn" href={base}>{L.all}</a>}
    {next ? <a class="btn primary" href={next}>{i + 2} →</a> : <a class="btn primary" href={base}>{L.all} →</a>}
  </nav>
</Base>

<script>
  import { bindSpeak } from '../../../../scripts/speak';
  import { mountHangul, normAnswer } from '../../../../scripts/hangul';
  import { saveQuiz } from '../../../../scripts/progress';
  bindSpeak();
  const $ = (id: string) => document.getElementById(id)!;
  const ex: { q: string; a: string }[] = JSON.parse($('ex').textContent!);
  if (ex.length && $('quiz')) {
    const l = $('l').dataset as Record<string, string>;
    const inp = $('qi') as HTMLInputElement;
    mountHangul(inp, $('kbd'), $('kt') as HTMLInputElement, $('kl') as HTMLSelectElement);
    let order: number[] = [], pos = 0, good = 0, firstTry = true, ok = 0;
    const start = () => { order = ex.map((_, i) => i).sort(() => Math.random() - 0.5); pos = 0; good = 0; $('qend').hidden = true; $('qf').hidden = false; show(); };
    const show = () => {
      if (pos >= order.length) {
        $('qf').hidden = true; $('qr').hidden = true; $('qend').hidden = false; $('qq').textContent = '';
        const pct = Math.round((good / ex.length) * 100); saveQuiz(l.id, pct);
        $('qe').textContent = pct === 100 ? `✓ ${l.done}` : `${good} / ${ex.length} ${l.score} — 100 % pour valider`;
        return;
      }
      firstTry = true; $('qr').hidden = true; $('qf').hidden = false; inp.value = ''; inp.focus();
      $('qn').textContent = `${pos + 1} / ${order.length}`; $('qs').textContent = `${good} ${l.score}`;
      $('qq').textContent = ex[order[pos]].q;
    };
    const res = (okv: boolean) => {
      const a = ex[order[pos]].a.split('|')[0];
      $('qf').hidden = true; $('qr').hidden = false;
      $('qm').innerHTML = okv ? `<b>${l.ok}</b>` : `${l.ko} <b lang="ko">${a}</b>`;
      if (okv && firstTry) good++;
      ok = okv ? 1 : 0; ($('qnx') as HTMLElement).focus();
    };
    $('qf').onsubmit = (e) => { e.preventDefault(); const v = normAnswer(inp.value); res(ex[order[pos]].a.split('|').some((x) => normAnswer(x) === v)); };
    $('qd').onclick = () => res(false);
    $('qnx').onclick = () => { pos++; show(); };
    $('qre').onclick = start;
    start();
  }
</script>
