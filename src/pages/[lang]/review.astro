---
import Base from '../../layouts/Base.astro';
import { t, subjectName, langPaths, type Lang } from '../../i18n';
import { allCards, subjectsList, unitsOf, parts } from '../../lib/content';
import { subjectConf, unitLabel } from '../../lib/subjects';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const cards = await allCards(lang);
const subjects = await subjectsList(lang);
const units = Object.fromEntries(await Promise.all(subjects.map(async (s) =>
  [s, (await unitsOf(lang, s)).map((u) => ({ slug: parts(u.id).slug, label: `${unitLabel(lang, s)} ${u.data.order} · ${u.data.title}` }))] as const)));
const meta = Object.fromEntries(subjects.map((s) => [s, { name: subjectName(lang, s), speech: subjectConf(s).speech ?? '', units: units[s] }]));
---
<Base lang={lang} title={t(lang, 'review.title')}>
  <h1 id="title">{t(lang, 'review.title')}</h1>
  <div id="picker" hidden>
    <p class="muted">{t(lang, 'review.pick')}</p>
    <div class="subjects">
      {subjects.map((s) => (
        <a class="subject-tile glass" href={`?subject=${s}`}>
          <span class="subject-icon">{subjectConf(s).icon}</span>
          <span class="subject-body"><strong>{subjectName(lang, s)}</strong></span>
          <span class="arrow">›</span>
        </a>
      ))}
    </div>
  </div>

  <div id="main" hidden>
  <div class="row between">
    <div class="row" style="gap:1rem;flex-wrap:wrap">
      <label class="switch"><input type="checkbox" id="slow" /> 🐢 {t(lang, 'review.slow')}</label>
      <label class="switch"><input type="checkbox" id="all" /> {t(lang, 'review.all_cards')}</label>
    </div>
  </div>

  <details class="glass filters" id="filters">
    <summary>{t(lang, 'review.filters')} <span class="muted small" id="f-count"></span></summary>
    <div class="frow" id="fr-kind"><span class="eyebrow">{t(lang, 'review.f_type')}</span><div class="row chips" id="f-kind"></div></div>
    <div class="frow" id="fr-unit"><span class="eyebrow">{t(lang, 'review.f_week')}</span><div class="row chips" id="f-unit"></div></div>
    <div class="frow" id="fr-topic"><span class="eyebrow">{t(lang, 'review.f_topic')}</span><div class="row chips" id="f-topic"></div></div>
    <div class="frow" id="fr-theme"><span class="eyebrow">{t(lang, 'review.f_theme')}</span><div class="row chips" id="f-theme"></div></div>
  </details>

  <div id="session">
    <div class="row between" style="margin-top:1.2rem">
      <span class="muted small"><strong id="left">0</strong> {t(lang, 'review.left')}</span>
      <span class="muted small" id="count"></span>
    </div>
    <div class="progress" style="margin-top:.5rem"><i id="bar"></i></div>
    <div class="stage">
      <div class="flip" id="flip" role="button" tabindex="0" aria-label={t(lang, 'review.show')}>
        <div class="face front glass"><div id="front"></div><button type="button" class="speak corner" id="speak-f" aria-label={t(lang, 'review.listen')} hidden>🔊</button><span class="hint">{t(lang, 'review.tap')}</span></div>
        <div class="face back glass"><div id="backc"></div><button type="button" class="speak corner" id="speak-b" aria-label={t(lang, 'review.listen')} hidden>🔊</button></div>
      </div>
    </div>
    <div id="mcq" class="opts" hidden></div>
    <button type="button" class="btn primary lg" id="show" style="width:100%;margin-top:.4rem" hidden>{t(lang, 'review.show')}</button>
    <div id="typed" hidden>
      <form id="typed-form" autocomplete="off">
        <div class="row" style="gap:.5rem"><input id="typed-in" lang="ko" style="flex:1;font-size:1.3rem" placeholder={t(lang, 'review.ph')} autocapitalize="off" autocorrect="off" spellcheck="false" /><button class="btn primary" id="typed-ok">{t(lang, 'review.check')}</button></div>
        <div class="row between" style="margin-top:.5rem"><button type="button" class="btn" id="dunno">{t(lang, 'review.dunno')}</button><span class="row" style="gap:.8rem"><select id="kb-layout" aria-label={t(lang, 'review.layout')}><option value="qwerty">QWERTY</option><option value="azerty">AZERTY</option></select><label class="switch"><input type="checkbox" id="kb-toggle" /> {t(lang, 'review.kb')}</label></span></div>
        <div class="kbd" id="kbd"></div>
      </form>
      <div class="box" id="typed-result" hidden><p id="tr-msg" style="margin:0 0 .6rem"></p><button type="button" class="btn primary" id="tr-next">{t(lang, 'review.next')} →</button></div>
    </div>
    <p style="text-align:center;margin:.8rem 0 0"><a class="small" id="lesson-link" target="_blank" rel="noopener" hidden>↗ {t(lang, 'review.see_lesson')}</a></p>
    <div class="answers" id="answers">
      <button type="button" id="again" class="btn-bad" disabled>✕ {t(lang, 'review.again')}</button>
      <button type="button" id="know" class="btn-ok" disabled>✓ {t(lang, 'review.know')}</button>
    </div>
    <p class="muted small" style="text-align:center;margin-top:1rem"><kbd>Espace</kbd> <kbd>1</kbd> <kbd>2</kbd> <kbd>S</kbd> 🔊</p>
  </div>

  <div class="glass done" id="end" hidden>
    <div class="check">✓</div>
    <p class="term" id="end-msg" style="margin:.2rem 0"></p>
    <p class="muted" id="end-sub"></p>
    <a class="btn primary" id="back-subject" href={`/${lang}/`}>← {t(lang, 'nav.home')}</a>
  </div>
  </div>

  <script type="application/json" id="cards" set:html={JSON.stringify({ cards, meta })} />
  <template id="i18n" data-empty={t(lang, 'review.empty')} data-done={t(lang, 'review.done')} data-reviewed={t(lang, 'review.reviewed')} data-k-vocab={t(lang, 'review.k_vocab')} data-k-notion={t(lang, 'review.k_notion')} data-k-drill={t(lang, 'review.k_drill')} data-k-formula={t(lang, 'review.k_formula')} data-listen={t(lang, 'review.listen')} data-ok={t(lang, 'review.correct')} data-ko={t(lang, 'review.wrong')}></template>
</Base>

<script>
  import { load, grade, isDue } from '../../scripts/progress';
  import { speak, mountSlow } from '../../scripts/speak';
  import { mountHangul, normAnswer } from '../../scripts/hangul';
  type Card = { id: string; subject: string; unit: string; deck: string; front: string; back: string; speak?: string; rfront?: string; rback?: string; ans?: string; w?: 1; mean?: string; kind: string; theme?: string; topic?: string; href?: string };
  type Meta = Record<string, { name: string; speech: string; units: { slug: string; label: string }[] }>;
  const { cards: all, meta } = JSON.parse(document.getElementById('cards')!.textContent!) as { cards: Card[]; meta: Meta };
  const i18n = document.getElementById('i18n')!.dataset;
  const $ = (id: string) => document.getElementById(id)!;
  const flip = $('flip'), again = $('again') as HTMLButtonElement, know = $('know') as HTMLButtonElement;
  const params = new URLSearchParams(location.search);
  const subject = params.get('subject') ?? '';
  const deck = params.get('deck');
  const allBox = $('all') as HTMLInputElement;
  const tin = $('typed-in') as HTMLInputElement;
  mountHangul(tin, $('kbd'), $('kb-toggle') as HTMLInputElement, $('kb-layout') as HTMLSelectElement);
  type Q = Card & { key: string; f: string; b: string; typed?: boolean; mode: 'flip' | 'mcq' | 'type' | 'listen' };
  const skip = (c: Card) => c.subject === 'coreen' && c.kind === 'notion'; // les notions s'apprennent dans la leçon ; on prouve via vocab + exercices
  let queue: Q[] = [], total = 0, seen = 0, busy = false;
  const m = meta[subject];
  const sel = { kind: new Set<string>(), unit: new Set<string>(), theme: new Set<string>(), topic: new Set<string>() };

  if (!m && !deck) $('picker').hidden = false;
  else {
    $('main').hidden = false;
    if (m) {
      $('title').textContent = m.name;
      ($('back-subject') as HTMLAnchorElement).href = `../${subject}/`;
      $('back-subject').textContent = '← ' + m.name;
    }
    mountSlow($('slow') as HTMLInputElement);
    buildFilters();
    allBox.onchange = start;
    start();
    document.addEventListener('progress:ready', () => { if (!seen) start(); });
  }

  function chips(row: string, key: keyof typeof sel, items: { v: string; l: string }[], pre: string[] | null) {
    $('fr-' + row).hidden = items.length < 2;
    const box = $('f-' + row);
    for (const it of items) {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = it.l;
      const on = !pre || pre.includes(it.v);
      if (on || items.length < 2) sel[key].add(it.v);
      b.setAttribute('aria-pressed', String(on || items.length < 2));
      b.onclick = () => {
        const was = b.getAttribute('aria-pressed') === 'true';
        b.setAttribute('aria-pressed', String(!was));
        was ? sel[key].delete(it.v) : sel[key].add(it.v);
        start();
      };
      box.append(b);
    }
  }
  function buildFilters() {
    const mine = all.filter((c) => (deck ? c.deck === deck : c.subject === subject) && !skip(c));
    const csv = (k: string) => params.get(k)?.split(',').filter(Boolean) ?? null;
    const kinds = [...new Set(mine.map((c) => c.kind))];
    chips('kind', 'kind', kinds.map((v) => ({ v, l: i18n['k' + v[0].toUpperCase() + v.slice(1)]! })), csv('kind'));
    chips('unit', 'unit', (m?.units ?? []).filter((u) => mine.some((c) => c.unit === u.slug)).map((u) => ({ v: u.slug, l: u.label.split(' · ')[0] })), csv('unit'));
    chips('topic', 'topic', [...new Set(mine.map((c) => c.topic).filter(Boolean) as string[])].map((v) => ({ v, l: v })), csv('topic'));
    chips('theme', 'theme', [...new Set(mine.map((c) => c.theme).filter(Boolean) as string[])].map((v) => ({ v, l: v })), csv('theme'));
    if (params.has('kind') || params.has('unit') || params.has('theme') || params.has('topic')) ($('filters') as HTMLDetailsElement).open = true;
  }
  function start() {
    const p = load();
    const modeOf = (c: Card): Q['mode'] => {
      if (c.kind === 'vocab' && c.mean) { const bx = p.cards[c.id]?.box ?? 0; return bx >= 4 && c.speak ? 'listen' : bx >= 2 ? 'type' : 'mcq'; }
      return c.w && c.ans ? 'type' : 'flip';
    };
    queue = all
      .filter((c) => (deck ? c.deck === deck : c.subject === subject) && !skip(c) && (!c.unit || sel.unit.has(c.unit)) && sel.kind.has(c.kind) && (!c.theme || sel.theme.has(c.theme)) && (!c.topic || sel.topic.has(c.topic)))
      .map((c): Q => {
        const mode = modeOf(c);
        if (mode === 'type') return { ...c, mode, typed: true, key: c.id, f: c.rfront ?? c.front, b: c.rback ?? c.back };
        if (mode === 'listen') return { ...c, mode, typed: true, key: c.id, f: `<div class="eyebrow">🎧</div><div class="muted">${i18n.listen}</div>`, b: c.rback ?? c.back };
        return { ...c, mode, key: c.id, f: c.front, b: mode === 'mcq' && c.rback ? c.rback : c.back };
      })
      .filter((c) => allBox.checked || isDue(p, c.key));
    for (let i = queue.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [queue[i], queue[j]] = [queue[j], queue[i]]; }
    total = queue.length; seen = 0;
    $('f-count').textContent = `· ${total}`;
    show();
  }
  function show() {
    const c = queue[0];
    $('left').textContent = String(queue.length);
    $('count').textContent = total ? `${total - queue.length} / ${total}` : '';
    ($('bar') as HTMLElement).style.width = total ? `${((total - queue.length) / total) * 100}%` : '0';
    $('session').hidden = !c; $('end').hidden = !!c;
    if (!c) {
      $('end-msg').textContent = seen ? i18n.done! : i18n.empty!;
      $('end-sub').textContent = seen ? `${seen} ${i18n.reviewed}` : '';
      $('end').querySelector('.check')!.toggleAttribute('hidden', !seen);
      return;
    }
    const ll = $('lesson-link') as HTMLAnchorElement; ll.hidden = !c.href; if (c.href) ll.href = c.href;
    flip.className = 'flip';
    $('front').innerHTML = c.f; $('backc').innerHTML = c.b;
    const rev = c.mode === 'type';
    $('typed').hidden = !c.typed; $('answers').hidden = true;
    $('mcq').hidden = c.mode !== 'mcq'; $('mcq').innerHTML = '';
    $('show').hidden = c.mode !== 'flip';
    if (c.mode === 'mcq') buildMcq(c);
    $('typed-form').hidden = false; $('typed-result').hidden = true; tin.value = '';
    if (c.typed) { tin.disabled = false; if (matchMedia('(pointer: fine)').matches) tin.focus(); }
    $('speak-f').hidden = !c.speak || rev; $('speak-b').hidden = !c.speak;
    void flip.offsetWidth; flip.classList.add('in');
    again.disabled = know.disabled = true;
    if (c.mode === 'listen') setTimeout(say, 350);
  }
  function buildMcq(c: Q) {
    const pool = all.filter((x) => x.kind === 'vocab' && x.subject === c.subject && x.mean && x.mean !== c.mean);
    const near = pool.filter((x) => x.theme === c.theme);
    const pick = new Map<string, true>();
    for (const src of [near, pool]) for (const x of src.sort(() => Math.random() - 0.5)) { if (pick.size >= 3) break; pick.set(x.mean!, true); }
    const opts = [...pick.keys(), c.mean!].sort(() => Math.random() - 0.5);
    const box = $('mcq');
    opts.forEach((o, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'btn'; b.textContent = `${i + 1}. ${o}`; b.dataset.v = o;
      b.onclick = () => {
        if (busy || $('typed-result').hidden === false) return;
        box.querySelectorAll<HTMLButtonElement>('button').forEach((x) => { x.disabled = true; if (x.dataset.v === c.mean) x.classList.add('btn-ok'); });
        if (o !== c.mean) b.classList.add('btn-bad');
        check(o === c.mean, c.mean);
      };
      box.append(b);
    });
  }
  const say = () => { const c = queue[0]; if (c?.speak) speak(c.speak, meta[c.subject]?.speech || 'ko-KR'); };
  function reveal() {
    if (!queue[0] || busy || queue[0].typed) return;
    flip.classList.remove('in');
    flip.classList.toggle('flipped');
    $('show').hidden = true; $('answers').hidden = false;
    again.disabled = know.disabled = false;
  }
  function answer(ok: boolean) {
    if (!queue[0] || busy || !flip.classList.contains('flipped')) return;
    busy = true;
    const c = queue.shift()!;
    grade(c.key, ok); seen++;
    if (!ok) queue.push(c); // revue dans la même session
    flip.classList.add(ok ? 'out-ok' : 'out-bad');
    setTimeout(() => { busy = false; show(); }, 320);
  }
  let typedOk = false;
  function check(ok: boolean, shown?: string) {
    const c = queue[0]; if (!c || busy) return;
    typedOk = ok;
    flip.classList.remove('in'); flip.classList.add('flipped');
    $('typed-form').hidden = true; $('typed-result').hidden = false; $('typed').hidden = false;
    $('tr-msg').innerHTML = ok ? `<b>${i18n.ok}</b>` : `${i18n.ko} <b lang="ko">${shown ?? c.ans}</b>`;
    ($('tr-next') as HTMLElement).focus();
  }
  $('typed-form').onsubmit = (e) => { e.preventDefault(); const c = queue[0]; if (c?.ans) check(normAnswer(tin.value) === normAnswer(c.ans)); };
  $('dunno').onclick = () => check(false);
  $('tr-next').onclick = () => answer(typedOk);
  flip.onclick = reveal;
  $('show').onclick = reveal;
  $('speak-f').onclick = $('speak-b').onclick = (e) => { e.stopPropagation(); say(); };
  again.onclick = () => answer(false);
  know.onclick = () => answer(true);
  document.addEventListener('keydown', (e) => {
    if (['SELECT', 'INPUT'].includes((e.target as HTMLElement).tagName)) return;
    const c0 = queue[0];
    if (e.key.toLowerCase() === 's') { say(); return; }
    if (c0?.mode === 'mcq') { const i = Number(e.key); if (i >= 1 && i <= 4) $('mcq').querySelectorAll<HTMLButtonElement>('button')[i - 1]?.click(); else if ((e.key === 'Enter' || e.key === ' ') && !$('typed-result').hidden) { e.preventDefault(); $('tr-next').click(); } return; }
    if (c0?.typed) return;
    if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); reveal(); }
    else if (e.key === '1') answer(false);
    else if (e.key === '2') answer(true);
    else if (e.key.toLowerCase() === 's') say();
  });
</script>
