---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, langPaths, type Lang } from '../../i18n';
import { parts } from '../../lib/content';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const ADJ_THEMES = new Set(['Adjectifs', 'Adjectives', 'Santé & état', 'Health & feelings']);
const seen = new Set<string>();
const words: { w: string; m: string; adj: boolean; unit: string }[] = [];
const units = new Set<string>();
for (const v of await getCollection('vocab')) {
  const { subject, slug } = parts(v.id, false);
  if (subject !== 'coreen') continue;
  for (const g of v.data.groups) for (const c of g.cards) {
    if (!/^[가-힣]+다$/.test(c.term) || seen.has(c.term)) continue;
    seen.add(c.term);
    words.push({ w: c.term, m: c[lang], adj: ADJ_THEMES.has(g.theme?.[lang] ?? '') || ['아름답다', '깨끗하다', '괜찮다'].includes(c.term), unit: slug });
    units.add(slug);
  }
}
const forms = ['present', 'past', 'future', 'can', 'seyo', 'jimaseyo', 'gosipeo', 'reo', 'boseyo', 'jianayo', 'mod'];
const labels = Object.fromEntries(forms.map((f) => [f, t(lang, 'conj.' + f)]));
---
<Base lang={lang} title={t(lang, 'conj.title')}>
  <h1>{t(lang, 'conj.title')}</h1>
  <p class="muted">{t(lang, 'conj.intro')}</p>

  <div id="setup" class="glass filters" style="margin-top:1rem">
    <div class="frow"><span class="eyebrow">{t(lang, 'conj.forms')}</span><div class="row chips" id="c-forms"></div></div>
    <div class="frow"><span class="eyebrow">{t(lang, 'review.f_type')}</span><div class="row chips" id="c-type"></div></div>
    <div class="frow"><span class="eyebrow">{t(lang, 'review.f_week')}</span><div class="row chips" id="c-units"></div></div>
    <div class="frow"><span class="eyebrow">{t(lang, 'conj.count')}</span><div class="row chips" id="c-count"></div></div>
    <p class="muted small" id="c-avail" style="margin:.8rem 0 0"></p>
    <button class="btn primary" id="c-start" style="margin-top:.8rem">{t(lang, 'conj.start')} →</button>
  </div>

  <div id="run" hidden>
    <div class="row between" style="margin-top:1.2rem"><span class="muted small" id="c-prog"></span><span class="muted small" id="c-score"></span></div>
    <div class="progress" style="margin-top:.5rem"><i id="c-bar"></i></div>
    <div class="glass done" style="margin-top:1rem;text-align:center;padding:2rem 1rem">
      <div class="eyebrow" id="q-form"></div>
      <div class="term" lang="ko" id="q-word" style="font-size:2.2rem"></div>
      <div class="muted" id="q-mean"></div>
    </div>
    <form id="c-form" autocomplete="off" style="margin-top:1rem">
      <div class="row" style="gap:.5rem"><input id="c-in" lang="ko" style="flex:1;font-size:1.3rem" placeholder={t(lang, 'review.ph')} autocapitalize="off" autocorrect="off" spellcheck="false" /><button class="btn primary" id="c-ok">{t(lang, 'review.check')}</button></div>
      <div class="row between" style="margin-top:.5rem"><button type="button" class="btn" id="c-skip">{t(lang, 'review.dunno')}</button><span class="row" style="gap:.8rem"><select id="kb-layout" aria-label={t(lang, 'review.layout')}><option value="qwerty">QWERTY</option><option value="azerty">AZERTY</option></select><label class="switch"><input type="checkbox" id="kb-toggle" /> {t(lang, 'review.kb')}</label></span></div>
      <div class="kbd" id="kbd"></div>
    </form>
    <div class="box" id="c-res" hidden><p id="c-msg" style="margin:0 0 .6rem"></p><button type="button" class="btn primary" id="c-next">{t(lang, 'review.next')} →</button></div>
  </div>

  <div class="glass done" id="c-end" hidden>
    <div class="check">✓</div>
    <p class="term" id="c-final" style="margin:.2rem 0"></p>
    <div id="c-wrong" style="text-align:left;margin:1rem 0"></div>
    <button class="btn primary" id="c-again">{t(lang, 'conj.again')}</button>
  </div>

  <script type="application/json" id="c-data" set:html={JSON.stringify({ words, units: [...units], labels, verbLabel: t(lang, 'conj.verbs'), adjLabel: t(lang, 'conj.adjs'), ok: t(lang, 'review.correct'), ko: t(lang, 'review.wrong') })} />
</Base>

<script>
  import { conj, FORMS_VERB, FORMS_ADJ, type Form } from '../../scripts/conj';
  import { mountHangul, normAnswer } from '../../scripts/hangul';
  type D = { words: { w: string; m: string; adj: boolean; unit: string }[]; units: string[]; labels: Record<string, string>; verbLabel: string; adjLabel: string; ok: string; ko: string };
  const D: D = JSON.parse(document.getElementById('c-data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const inp = $('c-in') as HTMLInputElement;
  mountHangul(inp, $('kbd'), $('kb-toggle') as HTMLInputElement, $('kb-layout') as HTMLSelectElement);

  const sel = { f: new Set<string>(['present', 'past', 'future']), t: new Set<string>(['v', 'a']), u: new Set<string>(D.units), n: 10 };
  function chips(id: string, items: [string, string][], set: Set<string>, single = false) {
    const box = $(id); box.innerHTML = '';
    for (const [v, l] of items) {
      const b = document.createElement('button'); b.type = 'button'; b.textContent = l;
      const paint = () => b.setAttribute('aria-pressed', String(set.has(v)));
      paint();
      b.onclick = () => { if (single) { set.clear(); set.add(v); box.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', 'false')); } else set.has(v) ? set.delete(v) : set.add(v); paint(); avail(); };
      box.append(b);
    }
  }
  const allForms = [...new Set([...FORMS_VERB, ...FORMS_ADJ])] as Form[];
  chips('c-forms', allForms.map((f) => [f, D.labels[f]]), sel.f);
  chips('c-type', [['v', D.verbLabel], ['a', D.adjLabel]], sel.t);
  chips('c-units', D.units.map((u) => [u, 'Week ' + parseInt(u.replace(/\D/g, ''))]), sel.u);
  const cnt = new Set(['10']);
  chips('c-count', [['10', '10'], ['20', '20'], ['50', '50']], cnt, true);
  type Q = { w: string; m: string; f: Form; a: string };
  function pool(): Q[] {
    const out: Q[] = [];
    for (const x of D.words) {
      if (!sel.u.has(x.unit) || !sel.t.has(x.adj ? 'a' : 'v')) continue;
      for (const f of sel.f as Set<Form>) if ((x.adj ? FORMS_ADJ : FORMS_VERB).includes(f)) out.push({ w: x.w, m: x.m, f, a: conj(x.w, f) });
    }
    return out;
  }
  const avail = () => { $('c-avail').textContent = `${pool().length} / ${D.words.length}`; ($('c-start') as HTMLButtonElement).disabled = !pool().length; };
  avail();

  let qs: Q[] = [], idx = 0, good = 0; const wrong: Q[] = [];
  function start() {
    const p = pool(); for (let i = p.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [p[i], p[j]] = [p[j], p[i]]; }
    qs = p.slice(0, Number([...cnt][0])); idx = 0; good = 0; wrong.length = 0;
    $('setup').hidden = true; $('c-end').hidden = true; $('run').hidden = false; ask();
  }
  function ask() {
    const q = qs[idx];
    $('q-form').textContent = D.labels[q.f]; $('q-word').textContent = q.w; $('q-mean').textContent = q.m;
    $('c-prog').textContent = `${idx + 1} / ${qs.length}`; $('c-score').textContent = `✓ ${good}`;
    ($('c-bar') as HTMLElement).style.width = `${(idx / qs.length) * 100}%`;
    inp.value = ''; $('c-form').hidden = false; $('c-res').hidden = true; if (matchMedia('(pointer: fine)').matches) inp.focus();
  }
  function check(ok: boolean) {
    const q = qs[idx]; if (!ok) wrong.push(q); else good++;
    $('c-form').hidden = true; $('c-res').hidden = false;
    $('c-msg').innerHTML = ok ? `<b>${D.ok}</b> <span lang="ko">${q.a}</span>` : `${D.ko} <b lang="ko">${q.a}</b>`;
    ($('c-next') as HTMLElement).focus();
  }
  function next() {
    if (++idx < qs.length) return ask();
    $('run').hidden = true; $('c-end').hidden = false;
    $('c-final').textContent = `${good} / ${qs.length}`;
    $('c-wrong').innerHTML = wrong.map((q) => `<div class="vrow"><span class="pill" lang="ko">${q.w}</span><span class="op">→</span><span class="pill" lang="ko">${q.a}</span><span class="muted small">${D.labels[q.f]}</span></div>`).join('');
  }
  $('c-start').onclick = start;
  $('c-again').onclick = () => { $('c-end').hidden = true; $('setup').hidden = false; avail(); };
  $('c-form').onsubmit = (e) => { e.preventDefault(); check(normAnswer(inp.value) === normAnswer(qs[idx].a)); };
  $('c-skip').onclick = () => check(false);
  $('c-next').onclick = next;
</script>
