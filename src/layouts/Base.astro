---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; title?: string }
const { lang, title } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const path = Astro.url.pathname;
const altPath = path.replace(/^\/(fr|en)(?=\/|$)/, '/' + other);
const nav = ['home', 'review', 'dashboard', 'search'] as const;
const href = (k: string) => `/${lang}/${k === 'home' ? '' : k + '/'}`;
const icons: Record<string, string> = {
  home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z',
  review: 'M4 6a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM20 7v12a3 3 0 0 1-3 3H8',
  dashboard: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-5-5',
};
const current = (k: string) => (k === 'home' ? path.replace(/\/$/, '') === `/${lang}` : path.startsWith(href(k)));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>{title ? `${title} · ${t(lang, 'site')}` : t(lang, 'site')}</title>
    <link rel="alternate" hreflang={other} href={altPath} />
    <script is:inline>
      try { const th = localStorage.getItem('theme'); if (th) document.documentElement.dataset.theme = th; } catch {}
    </script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--accent)" /><stop offset="1" stop-color="var(--accent-2)" /></linearGradient></defs>
    </svg>
    <header>
      <nav>
        <a class="brand" href={href('home')}><i></i><span>{t(lang, 'site')}</span></a>
        <div class="links">
          {nav.map((k) => <a href={href(k)} aria-current={current(k) ? 'page' : undefined}>{t(lang, 'nav.' + k)}</a>)}
        </div>
        <div class="tools">
          <button id="theme" class="icon" type="button" aria-label={t(lang, 'theme')}>◐</button>
          <a href={altPath} hreflang={other}>{other.toUpperCase()}</a>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <nav class="tabbar" aria-label="Navigation">
      {nav.map((k) => (
        <a href={href(k)} aria-current={current(k) ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[k]} /></svg>
          <span>{t(lang, 'nav.' + k)}</span>
        </a>
      ))}
    </nav>
    <script>
      import { sync } from '../scripts/progress';
      sync().then((s) => document.dispatchEvent(new CustomEvent('progress:ready', { detail: s })));
      document.getElementById('theme')!.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
